# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=your-groq-model
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
